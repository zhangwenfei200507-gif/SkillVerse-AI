{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local main window commands and workflow event subscription",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-is-minimized",
    "allow-workflow-engine",
    "allow-learning-engine",
    "allow-capability-intelligence",
    "allow-intelligence-credential",
    "allow-list-capabilities",
    "allow-get-capability",
    "allow-list-domains",
    "allow-get-capability-relations",
    "allow-save-graph-layout",
    "allow-load-graph-layout",
    "allow-get-installation-status",
    "allow-get-learning-progress",
    "allow-update-learning-progress",
    "allow-check-database-integrity",
    "allow-desktop-startup",
    "allow-create-database-backup",
    "allow-scan-codex",
    "allow-capability-reconciliation-preview",
    "allow-capability-reconciliation-apply",
    "allow-get-codex-scan",
    "allow-github-discovery-state",
    "allow-github-run",
    "allow-github-cancel",
    "allow-github-resume",
    "allow-github-set-token",
    "allow-github-classify",
    "allow-github-installation-plan",
    "allow-installation-state",
    "allow-installation-prepare",
    "allow-installation-operation",
    "allow-installation-execute",
    "allow-installation-cancel",
    "allow-installation-recover",
    "allow-installation-verify"
  ]
}
